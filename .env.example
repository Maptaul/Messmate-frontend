# Where the MessMate API lives. The browser never calls it directly: next.config.ts
# rewrites /api/v1/* to it, so the auth cookies land on this app's own domain.
# Live:  https://messmatebackend.vercel.app
# Local: http://localhost:5000
BACKEND_URL=https://messmatebackend.vercel.app

# Same value as the API's JWT_ACCESS_SECRET. Server-only; proxy.ts uses it to
# verify the access token before routing by role.
JWT_ACCESS_SECRET=

# This app's public origin, used for metadataBase / Open Graph URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# The API's Google OAuth client id (public by design). Empty hides the Google button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# The inbox the contact page opens the visitor's email app to.
NEXT_PUBLIC_CONTACT_EMAIL=
