# Where the MessMate API lives. The browser never calls it directly: next.config.ts
# rewrites /api/v1/* to it, so auth cookies land on this app's own domain.
# Local:      http://localhost:5000
# Production: https://messmatebackend.vercel.app
BACKEND_URL=

# Same value as the backend's JWT_ACCESS_SECRET. Server-only; proxy.ts uses it to
# verify the access token before routing by role.
JWT_ACCESS_SECRET=

# This app's public origin, used for metadataBase / Open Graph URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_CONTACT_EMAIL=
